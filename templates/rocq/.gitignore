# workspace configs
.vscode/*
!.vscode/settings.json

# dune build output, the local opam switch and the project's own opam root
_build/
_opam/
.opam-root/
*.install

# generated by (generate_project_file) in theories/dune -- points into
# _build/default/..., not meant to be committed
_RocqProject
_CoqProject

# tactic caches some rocq tools drop next to sources
*.lia.cache
*.nia.cache
