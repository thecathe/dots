use flake

# The flake's shellHook has already pointed OPAMROOT at ./.opam-root, so this
# and every other opam command here uses the project's own opam root, never
# ~/.opam.
#
# Only activate the switch once it exists -- on a fresh clone it does not,
# and `opam env` would error. The flake's shellHook prints (and can run)
# the bootstrap command in that case.
if [ -d "$PWD/_opam" ]; then
  eval "$(opam env --switch="$PWD" --set-switch)"
fi

# nix-direnv already watches flake.nix/flake.lock; reload when a pinned
# dependency set changes too.
for f in *.opam.locked; do
  [ -e "$f" ] && watch_file "$f"
done
