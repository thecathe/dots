{
  // Run `elp` from PATH. The extension otherwise launches the server it
  // bundles, but the universal marketplace build bundles a macOS (Mach-O)
  // binary, which cannot execute on Linux. .envrc already puts this devShell's
  // erlang-language-platform on PATH once the shell is entered (via
  // mkhl.direnv, which injects it into the extension host's own process).
  //
  // This only applies when the project is opened as its own folder. In a
  // multi-root workspace (a *.code-workspace with several folders) VS Code
  // reads only resource-scoped settings from a folder's .vscode/settings.json,
  // and elp.serverPath is not one, so the bundled binary is launched again.
  // For those windows set it in user settings instead (dots' erlang VS Code
  // profile does) or under "settings" in the .code-workspace file.
  "elp.serverPath": "elp"
}
