use flake

# Only activate the venv once it exists -- on a fresh clone it does not;
# create it with `uv sync`.
if [ -x "$PWD/.venv/bin/python" ]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
else
  # The flake's shellHook also says this, but nix-direnv caches the shell and
  # only re-runs the hook when the flake changes -- so repeat it here, where
  # it fires on every entry until the venv exists.
  log_status "no .venv yet -- run 'uv sync' (or 'nix develop' for a prompt)"
fi

# nix-direnv already watches flake.nix/flake.lock; reload when the
# dependency set changes too.
watch_file pyproject.toml uv.lock
