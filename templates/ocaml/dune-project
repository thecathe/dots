(lang dune 3.17)
; ^ this must be the literal first line of the file -- dune errors if
; anything, even a comment, precedes it. Bump the version as your installed
; dune allows.

; dune can generate .opam files from this specification.
; Run `dune build` to regenerate them after editing this file.
(generate_opam_files true)

(package
 (name my-project)
 ; Lets `dune build` succeed before you've added any library/executable
 ; stanzas; without it dune reports the package as empty, which is an error
 ; (the .opam file is still written). Harmless once you add real stanzas.
 (allow_empty)
 (synopsis "A short synopsis")
 (description "A longer description")
 (depends
  ; Minimum OCaml version — match this to your opam switch version.
  (ocaml (>= 5.2))
  dune
  ; `:with-dev-setup` marks these as development-only.
  ; Install them with: opam install . --deps-only --with-dev-setup
  ;
  ; Each ocaml-lsp-server release supports one OCaml minor version, and its
  ; metadata puts no upper bound on the dune libraries it builds against, so
  ; opam cannot see a combination that fails to compile. Raising the `ocaml`
  ; bound alone to 5.4.1 gave OCaml 5.4.1 with ocaml-lsp-server 1.26.1, which
  ; does not build against stdune 3.25 ("Unbound value Pid.of_int"). When you
  ; raise `ocaml` above, raise this lower bound with it (1.27 for OCaml 5.5).
  (ocaml-lsp-server (and :with-dev-setup (>= 1.18)))
  ; ocamlformat version must exactly match the `version` key in .ocamlformat.
  (ocamlformat      (and :with-dev-setup (= 0.26.2)))))
