# workspace configs
.vscode
# neovim sessions live in the private workspaces repo (see modules/home/nvim/lua/utils.lua);
# this is only the fallback used when that repo is absent
/.nvim/*.json
!/templates/*/.vscode

# nix build output symlink
result

# ignore local aliasas/dirhash
modules/home/shell/zsh/aliases.local.zsh
modules/home/shell/zsh/dirs.local.zsh
# allows local settings to be overridden
modules/home/claude/settings.local.json
modules/home/dank/session.local.json

# host-local backups, not meant to be shared/committed
/_local_backups/
CLAUDE.md

# local Claude planning notes
/.claude/plans/
