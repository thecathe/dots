import QtQuick
import qs.Common
import qs.Modules.Plugins
import qs.Services
import qs.Widgets

// Bar pill + popout listing dots.services. Nothing runs while the popout is
// closed: opening it runs one status command (a script generated by
// modules/home/dank/services-menu.nix, printing "<name> up|down" per service),
// and clicking a service runs its up or down command, then checks again. A
// service with extra actions also has a "..." button on its row, which opens
// them in a list under the row.
PluginComponent {
    id: root

    // [{ name, label, icon, up: [argv], down: [argv], actions: [{ label, icon, argv }] }],
    // from this plugin's settings.
    readonly property var services: pluginData.services || []
    readonly property string statusCommand: pluginData.statusCommand || ""

    // name -> true (up) / false (down). Missing until the first check.
    property var states: ({})
    property bool checking: false
    // The service being switched, "" when none. One at a time.
    property string busy: ""
    // The service whose actions are open, "" when none. One at a time.
    property string expanded: ""

    function refresh() {
        if (statusCommand === "")
            return;
        checking = true;
        Proc.runCommand("dotsServices.status", [statusCommand], (stdout, exitCode) => {
            const next = {};
            for (const line of stdout.split("\n")) {
                const parts = line.trim().split(" ");
                if (parts.length === 2)
                    next[parts[0]] = parts[1] === "up";
            }
            states = next;
            checking = false;
        }, 0);
    }

    function toggle(service) {
        if (busy !== "")
            return;
        const wasUp = states[service.name] === true;
        busy = service.name;
        Proc.runCommand("dotsServices.toggle." + service.name, wasUp ? service.down : service.up, (stdout, exitCode) => {
            if (exitCode !== 0)
                ToastService.showError(service.label + ": " + (wasUp ? "stopping" : "starting") + " failed (exit " + exitCode + ")");
            busy = "";
            refresh();
        }, 0);
    }

    // Fire and forget: a terminal action returns at once (kitty --detach), and a
    // background one may run for as long as it likes, so no timeout (-1).
    function runAction(service, action) {
        expanded = "";
        Proc.runCommand("dotsServices.action." + service.name, action.argv, (stdout, exitCode) => {
            if (exitCode !== 0)
                ToastService.showError(service.label + ": " + action.label + " failed (exit " + exitCode + ")");
        }, 0, -1);
    }

    function stateText(name) {
        if (busy === name)
            return "…";
        if (!(name in states))
            return checking ? "…" : "?";
        return states[name] ? "up" : "down";
    }

    horizontalBarPill: Component {
        DankIcon {
            name: "dns"
            size: Theme.barIconSize(root.barThickness, -4)
            color: Theme.widgetIconColor
        }
    }

    verticalBarPill: Component {
        DankIcon {
            name: "dns"
            size: Theme.barIconSize(root.barThickness, -4)
            color: Theme.widgetIconColor
        }
    }

    popoutWidth: 320

    popoutContent: Component {
        PopoutComponent {
            id: popout

            headerText: "Services"
            showCloseButton: true

            // Injected by PluginPopout; used to check again on every opening,
            // since the content is kept between openings.
            property var parentPopout: null

            Component.onCompleted: root.refresh()

            Connections {
                target: popout.parentPopout
                function onShouldBeVisibleChanged() {
                    if (popout.parentPopout.shouldBeVisible) {
                        root.expanded = "";
                        root.refresh();
                    }
                }
            }

            Column {
                width: parent.width
                spacing: Theme.spacingXS

                StyledText {
                    visible: root.services.length === 0
                    text: "No services on this machine"
                    color: Theme.surfaceVariantText
                    font.pixelSize: Theme.fontSizeMedium
                }

                Repeater {
                    model: root.services

                    delegate: Column {
                        id: item

                        required property var modelData
                        readonly property var actions: modelData.actions || []
                        readonly property bool hasActions: actions.length > 0
                        readonly property bool isOpen: root.expanded === modelData.name
                        // The "..." button's size; the state text keeps clear of it.
                        readonly property real moreSize: 32

                        // A Repeater evaluates a delegate once before it has a parent.
                        width: parent ? parent.width : 0
                        spacing: 2

                        Rectangle {
                            id: row

                            readonly property bool isUp: root.states[item.modelData.name] === true

                            width: parent.width
                            height: 44
                            radius: Theme.cornerRadius
                            color: area.containsMouse ? Theme.primaryHover : "transparent"

                            Row {
                                anchors.left: parent.left
                                anchors.leftMargin: Theme.spacingM
                                anchors.verticalCenter: parent.verticalCenter
                                spacing: Theme.spacingM

                                DankIcon {
                                    name: item.modelData.icon
                                    size: Theme.iconSize
                                    color: row.isUp ? Theme.primary : Theme.surfaceVariantText
                                    anchors.verticalCenter: parent.verticalCenter
                                }

                                StyledText {
                                    text: item.modelData.label
                                    color: Theme.surfaceText
                                    font.pixelSize: Theme.fontSizeMedium
                                    anchors.verticalCenter: parent.verticalCenter
                                }
                            }

                            // Leaves room for the "..." button when there is one.
                            StyledText {
                                anchors.right: parent.right
                                anchors.rightMargin: item.hasActions ? Theme.spacingM + item.moreSize + Theme.spacingXS : Theme.spacingM
                                anchors.verticalCenter: parent.verticalCenter
                                text: root.stateText(item.modelData.name)
                                color: row.isUp ? Theme.primary : Theme.surfaceVariantText
                                font.pixelSize: Theme.fontSizeMedium
                            }

                            MouseArea {
                                id: area
                                anchors.fill: parent
                                hoverEnabled: true
                                enabled: root.busy === ""
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.toggle(item.modelData)
                            }

                            // Declared after the toggle's MouseArea, so it sits on top
                            // of it and a click here never switches the service.
                            Rectangle {
                                id: moreButton

                                visible: item.hasActions
                                width: item.moreSize
                                height: item.moreSize
                                radius: Theme.cornerRadius
                                anchors.right: parent.right
                                anchors.rightMargin: Theme.spacingXS
                                anchors.verticalCenter: parent.verticalCenter
                                color: moreArea.containsMouse || item.isOpen ? Theme.primaryHover : "transparent"

                                DankIcon {
                                    anchors.centerIn: parent
                                    name: "more_horiz"
                                    size: Theme.iconSize
                                    color: item.isOpen ? Theme.primary : Theme.surfaceVariantText
                                }

                                MouseArea {
                                    id: moreArea
                                    anchors.fill: parent
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.expanded = item.isOpen ? "" : item.modelData.name
                                }
                            }
                        }

                        // The service's actions, under its row while the "..." is open.
                        Column {
                            visible: item.isOpen
                            width: parent.width
                            spacing: 2

                            Repeater {
                                model: item.actions

                                delegate: Rectangle {
                                    id: actionRow

                                    required property var modelData

                                    width: parent.width
                                    height: 36
                                    radius: Theme.cornerRadius
                                    color: actionArea.containsMouse ? Theme.primaryHover : "transparent"

                                    Row {
                                        anchors.left: parent.left
                                        // Lines up with the service's label above.
                                        anchors.leftMargin: Theme.spacingM + Theme.iconSize + Theme.spacingM
                                        anchors.verticalCenter: parent.verticalCenter
                                        spacing: Theme.spacingS

                                        DankIcon {
                                            name: actionRow.modelData.icon
                                            size: Theme.iconSizeSmall
                                            color: Theme.surfaceVariantText
                                            anchors.verticalCenter: parent.verticalCenter
                                        }

                                        StyledText {
                                            text: actionRow.modelData.label
                                            color: Theme.surfaceText
                                            font.pixelSize: Theme.fontSizeMedium
                                            anchors.verticalCenter: parent.verticalCenter
                                        }
                                    }

                                    MouseArea {
                                        id: actionArea
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.runAction(item.modelData, actionRow.modelData)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
