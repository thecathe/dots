import QtQuick
import qs.Common
import qs.Modules.Plugins
import qs.Services
import qs.Widgets

// Bar pill + popout listing dots.services. Nothing runs while the popout is
// closed: opening it runs one status command (a script generated by
// modules/home/dank/services-menu.nix, printing "<name> up|down" per service),
// and clicking a service runs its up or down command, then checks again.
PluginComponent {
    id: root

    // [{ name, label, icon, up: [argv], down: [argv] }], from this plugin's settings.
    readonly property var services: pluginData.services || []
    readonly property string statusCommand: pluginData.statusCommand || ""

    // name -> true (up) / false (down). Missing until the first check.
    property var states: ({})
    property bool checking: false
    // The service being switched, "" when none. One at a time.
    property string busy: ""

    function refresh() {
        if (statusCommand === "")
            return;
        checking = true;
        Proc.runCommand("dotsServices.status", [statusCommand], (stdout, exitCode) => {
            const next = {};
            for (const line of stdout.split("\n")) {
                const parts = line.trim().split(" ");
                if (parts.length === 2)
                    next[parts[0]] = parts[1] === "up";
            }
            states = next;
            checking = false;
        }, 0);
    }

    function toggle(service) {
        if (busy !== "")
            return;
        const wasUp = states[service.name] === true;
        busy = service.name;
        Proc.runCommand("dotsServices.toggle." + service.name, wasUp ? service.down : service.up, (stdout, exitCode) => {
            if (exitCode !== 0)
                ToastService.showError(service.label + ": " + (wasUp ? "stopping" : "starting") + " failed (exit " + exitCode + ")");
            busy = "";
            refresh();
        }, 0);
    }

    function stateText(name) {
        if (busy === name)
            return "…";
        if (!(name in states))
            return checking ? "…" : "?";
        return states[name] ? "up" : "down";
    }

    horizontalBarPill: Component {
        DankIcon {
            name: "dns"
            size: Theme.barIconSize(root.barThickness, -4)
            color: Theme.widgetIconColor
        }
    }

    verticalBarPill: Component {
        DankIcon {
            name: "dns"
            size: Theme.barIconSize(root.barThickness, -4)
            color: Theme.widgetIconColor
        }
    }

    popoutWidth: 320

    popoutContent: Component {
        PopoutComponent {
            id: popout

            headerText: "Services"
            showCloseButton: true

            // Injected by PluginPopout; used to check again on every opening,
            // since the content is kept between openings.
            property var parentPopout: null

            Component.onCompleted: root.refresh()

            Connections {
                target: popout.parentPopout
                function onShouldBeVisibleChanged() {
                    if (popout.parentPopout.shouldBeVisible)
                        root.refresh();
                }
            }

            Column {
                width: parent.width
                spacing: Theme.spacingXS

                StyledText {
                    visible: root.services.length === 0
                    text: "No services on this machine"
                    color: Theme.surfaceVariantText
                    font.pixelSize: Theme.fontSizeMedium
                }

                Repeater {
                    model: root.services

                    delegate: Rectangle {
                        id: row

                        required property var modelData
                        readonly property bool isUp: root.states[modelData.name] === true

                        width: parent.width
                        height: 44
                        radius: Theme.cornerRadius
                        color: area.containsMouse ? Theme.primaryHover : "transparent"

                        Row {
                            anchors.left: parent.left
                            anchors.leftMargin: Theme.spacingM
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: Theme.spacingM

                            DankIcon {
                                name: row.modelData.icon
                                size: Theme.iconSize
                                color: row.isUp ? Theme.primary : Theme.surfaceVariantText
                                anchors.verticalCenter: parent.verticalCenter
                            }

                            StyledText {
                                text: row.modelData.label
                                color: Theme.surfaceText
                                font.pixelSize: Theme.fontSizeMedium
                                anchors.verticalCenter: parent.verticalCenter
                            }
                        }

                        StyledText {
                            anchors.right: parent.right
                            anchors.rightMargin: Theme.spacingM
                            anchors.verticalCenter: parent.verticalCenter
                            text: root.stateText(row.modelData.name)
                            color: row.isUp ? Theme.primary : Theme.surfaceVariantText
                            font.pixelSize: Theme.fontSizeMedium
                        }

                        MouseArea {
                            id: area
                            anchors.fill: parent
                            hoverEnabled: true
                            enabled: root.busy === ""
                            cursorShape: Qt.PointingHandCursor
                            onClicked: root.toggle(row.modelData)
                        }
                    }
                }
            }
        }
    }
}
